+/* Same-VM fence sharing uses the same access-model split as XISO_IMPORT:
+ * Linux guest fd rights authorize the source; QEMU validates both independent
+ * (isolate, handle) principals and never accepts a guest-provided host fd. */
+int nvkvm_req_import_sync_file(VirtIONvgpu *nv,
+    struct nvkvm_req_import_sync_file *req, struct nvkvm_resp_import_sync_file *resp)
+{
+	resp->status = EPERM;
+	if (!nv->graphics || !nv->sync_file_bridge ||
+	    !poll_pair_ok(nv, req->render_handle, req->isolate_id))
+		return 0;
+	struct nvkvm_handle *render = nvkvm_handle_get(&nv->handles, req->render_handle);
+	if (!render || render->type != NVKVM_HANDLE_TYPE_NVIDIA ||
+	    render->dev_id < 32 || render->dev_id >= 48)
+		return 0;
+	if (req->pre_wait_value >= req->post_wait_value ||
+	    (req->flags & ~NVKVM_SYNC_IMPORT_SIGNALED)) {
+		resp->status = EINVAL;
+		return 0;
+	}
+	int fd = -1;
+	if (req->flags & NVKVM_SYNC_IMPORT_SIGNALED) {
+		if (req->owner_isolate_id || req->owner_handle) {
+			resp->status = EINVAL;
+			return 0;
+		}
+	} else {
+		uint32_t source_session = 0;
+		fd = nvkvm_handle_acquire_sync_file(&nv->handles, req->owner_handle, &source_session);
+		if (fd < 0) {
+			resp->status = (uint32_t)-fd;
+			return 0;
+		}
+		if (!session_has_isolate(nv, source_session, req->owner_isolate_id)) {
+			close(fd);
+			return 0;
+		}
+	}
+	int ret = nvkvm_isolate_import_sync_file(&nv->isolates, req->isolate_id,
+		req->render_handle, req->fence_context_handle, fd,
+		req->pre_wait_value, req->post_wait_value);
+	if (fd >= 0)
+		close(fd);
+	NVKVM_DBG("nvkvm sync import: isolate=%u context=%u source=%u:%u flags=%u pre=%llu post=%llu ret=%d\n",
+		req->isolate_id, req->fence_context_handle, req->owner_isolate_id,
+		req->owner_handle, req->flags, (unsigned long long)req->pre_wait_value,
+		(unsigned long long)req->post_wait_value, ret);
+	resp->status = ret < 0 ? (uint32_t)-ret : 0;
+	return 0;
+}
