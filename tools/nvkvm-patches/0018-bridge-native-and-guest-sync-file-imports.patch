+/* Guest-created fences have no native descriptor. Keep the GPU's semaphore
+ * wait asynchronous: acknowledge registration now, and ask the host driver
+ * to advance pre -> post only after the actual guest fence completes. No
+ * worker is parked on an unsignalled fence, so a full set of imports cannot
+ * starve the export monitors or their cleanup work. */
+struct nvkvm_sync_import {
+	struct dma_fence *fence;
+	struct dma_fence_cb callback;
+	struct drm_gem_object *context;
+	struct nvkvm_fd_ctx *target;
+	struct list_head node;
+	struct work_struct work;
+	atomic_t scheduled;
+	__u32 stub_context;
+	__u64 pre, post;
+};
+
+void nvkvm_sync_imports_init(struct nvkvm_fd_ctx *ctx)
+{
+	mutex_init(&ctx->sync_imports_lock);
+	INIT_LIST_HEAD(&ctx->sync_imports);
+}
+
+static void sync_import_schedule(struct nvkvm_sync_import *import)
+{
+	/* Completion and file close may race. Queue/free this work exactly once,
+	 * including when cancellation sees work that has already started. */
+	if (atomic_cmpxchg(&import->scheduled, 0, 1) == 0)
+		queue_work(sync_wq, &import->work);
+}
+
+static void sync_import_ready(struct dma_fence *fence, struct dma_fence_cb *cb)
+{
+	struct nvkvm_sync_import *import = container_of(cb, struct nvkvm_sync_import, callback);
+	sync_import_schedule(import);
+}
+
+void nvkvm_sync_imports_cancel(struct nvkvm_fd_ctx *ctx)
+{
+	struct nvkvm_sync_import *import;
+	mutex_lock(&ctx->sync_imports_lock);
+	ctx->sync_imports_closed = true;
+	list_for_each_entry(import, &ctx->sync_imports, node) {
+		dma_fence_remove_callback(import->fence, &import->callback);
+		sync_import_schedule(import);
+	}
+	mutex_unlock(&ctx->sync_imports_lock);
+}
+
+static void sync_import_finish(struct work_struct *work)
+{
+	struct nvkvm_sync_import *import = container_of(work, struct nvkvm_sync_import, work);
+	struct nvkvm_fd_ctx *target = import->target;
+	/* Serializes with an in-flight fence callback before its storage is freed. */
+	dma_fence_remove_callback(import->fence, &import->callback);
+	mutex_lock(&target->sync_imports_lock);
+	bool closed = target->sync_imports_closed;
+	list_del(&import->node);
+	target->sync_imports_count--;
+	mutex_unlock(&target->sync_imports_lock);
+	int status = dma_fence_get_status(import->fence);
+	if (!closed && status == 1 && nvkvm_transport_ready(&nvkvm)) {
+		int ret = nvkvm_virtio_import_sync_file(target, import->stub_context,
+			NULL, import->pre, import->post);
+		if (ret)
+			pr_warn_ratelimited("nvkvm: deferred sync import registration failed: %d\n", ret);
+	} else if (!closed && status < 0) {
+		/* Never convert a failed producer into successful GPU completion. */
+		pr_warn_ratelimited("nvkvm: sync import producer failed: %d\n", status);
+	}
+	dma_fence_put(import->fence);
+	drm_gem_object_put(import->context);
+	nvkvm_fd_ctx_put(target);
+	kfree(import);
+	module_put(THIS_MODULE);
+}
+
+int nvkvm_sync_file_import(struct nvkvm_fd_ctx *target, struct drm_gem_object *context,
+    __u32 stub_context, int fd, __u64 pre, __u64 post)
+{
+	struct dma_fence *fence = sync_file_get_fence(fd);
+	if (!fence)
+		return -EINVAL;
+	int status = dma_fence_get_status(fence);
+	int ret;
+	if (status < 0) {
+		ret = status;
+		goto out;
+	}
+	if (fence->ops == &sync_ops) {
+		struct nvkvm_sync_fence *nf = container_of(fence, struct nvkvm_sync_fence, base);
+		ret = nvkvm_virtio_import_sync_file(target, stub_context, nf->ctx, pre, post);
+		goto out;
+	}
+	if (status == 1) {
+		ret = nvkvm_virtio_import_sync_file(target, stub_context, NULL, pre, post);
+		goto out;
+	}
+	struct nvkvm_sync_import *import = kzalloc(sizeof(*import), GFP_KERNEL);
+	if (!import) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	if (!try_module_get(THIS_MODULE)) {
+		kfree(import);
+		ret = -ENODEV;
+		goto out;
+	}
+	import->fence = fence;
+	import->context = context;
+	import->target = target;
+	import->stub_context = stub_context;
+	import->pre = pre;
+	import->post = post;
+	INIT_WORK(&import->work, sync_import_finish);
+	atomic_set(&import->scheduled, 0);
+	mutex_lock(&target->sync_imports_lock);
+	if (target->sync_imports_closed || target->sync_imports_count >= 4096) {
+		mutex_unlock(&target->sync_imports_lock);
+		module_put(THIS_MODULE);
+		kfree(import);
+		ret = -EBUSY;
+		goto out;
+	}
+	nvkvm_fd_ctx_get(target);
+	drm_gem_object_get(context);
+	list_add(&import->node, &target->sync_imports);
+	target->sync_imports_count++;
+	mutex_unlock(&target->sync_imports_lock);
+	/* ioctl holds the file alive through callback registration. postclose
+	 * cannot cancel an import until this registration has finished. */
+	ret = dma_fence_add_callback(fence, &import->callback, sync_import_ready);
+	if (ret) /* Already terminal; finish checks the actual status. */
+		sync_import_schedule(import);
+	return 0; /* work owns the fence and destination references */
+out:
+	dma_fence_put(fence);
+	return ret;
+}
