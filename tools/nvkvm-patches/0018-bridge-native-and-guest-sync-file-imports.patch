+/* A DRM CPU stub fence is device-independent and already signalled. It is
+ * used only for guest imports whose real producer has completed; it is never
+ * used to pretend that a pending producer finished. Reader-thread owned. */
+#ifndef MSG_CTRUNC
+#define MSG_CTRUNC 0x08
+#endif
+#ifndef MSG_TRUNC
+#define MSG_TRUNC 0x20
+#endif
+static int completed_sync_file = -1;
+
+static int get_completed_sync_file(int render)
+{
+	if (completed_sync_file >= 0)
+		return completed_sync_file;
+	struct { uint32_t handle, flags; } create = { .flags = 1 };
+	long ret = stub_ioctl(render, 0xc00864bfu, &create); /* SYNCOBJ_CREATE(SIGNALED) */
+	if (ret < 0)
+		return (int)ret;
+	struct { uint32_t handle, flags; int32_t fd; uint32_t pad; } export = {
+		.handle = create.handle, .flags = 1, .fd = -1,
+	};
+	ret = stub_ioctl(render, 0xc01064c1u, &export); /* HANDLE_TO_FD(EXPORT_SYNC_FILE) */
+	create.flags = 0;
+	stub_ioctl(render, 0xc00864c0u, &create); /* SYNCOBJ_DESTROY */
+	if (ret < 0)
+		return (int)ret;
+	if (export.fd < 0)
+		return -EIO;
+	completed_sync_file = export.fd;
+	return completed_sync_file;
+}
+
+static void handle_import_sync_file(const struct isolate_cmd_import_sync_file *cmd,
+    struct msghdr *msg, long length)
+{
+	int source = -1, count = 0;
+	struct cmsghdr *cm = CMSG_FIRSTHDR(msg);
+	if (cm && cm->cmsg_level == SOL_SOCKET && cm->cmsg_type == SCM_RIGHTS &&
+	    cm->cmsg_len >= CMSG_LEN(0) && cm->cmsg_len <= msg->msg_controllen) {
+		count = (int)((cm->cmsg_len - CMSG_LEN(0)) / sizeof(int));
+		for (int i = 0; i < count; i++) {
+			int fd;
+			__builtin_memcpy(&fd, (char *)CMSG_DATA(cm) + i * sizeof(fd), sizeof(fd));
+			if (i == 0)
+				source = fd;
+			else
+				stub_close(fd);
+		}
+	}
+	int ret = -EINVAL;
+	int render = -1;
+	if (length != (long)sizeof(*cmd) || (msg->msg_flags & (MSG_CTRUNC | MSG_TRUNC)) ||
+	    (cmd->flags & ~NVKVM_SYNC_IMPORT_SIGNALED) ||
+	    cmd->pre_wait_value >= cmd->post_wait_value)
+		goto done;
+	if ((cmd->flags & NVKVM_SYNC_IMPORT_SIGNALED) ? count != 0 : count != 1)
+		goto done;
+	uint32_t dev = handle_dev_lookup(cmd->render_handle);
+	render = handle_lookup(cmd->render_handle);
+	if (render < 0 || dev < 32 || dev >= 48) {
+		ret = -EBADF;
+		goto done;
+	}
+	int fence_fd = source;
+	if (cmd->flags & NVKVM_SYNC_IMPORT_SIGNALED)
+		fence_fd = get_completed_sync_file(render);
+	if (fence_fd < 0) {
+		ret = fence_fd;
+		goto done;
+	}
+	struct sync_file_info info = {0};
+	ret = (int)stub_ioctl(fence_fd, SYNC_IOC_FILE_INFO, &info);
+	if (ret < 0)
+		goto done;
+	if (info.status < 0) {
+		ret = info.status;
+		goto done;
+	}
+	struct {
+		uint32_t context;
+		int32_t fd;
+		uint64_t pre, post;
+	} params = { .context = cmd->fence_context_handle, .fd = fence_fd,
+		.pre = cmd->pre_wait_value, .post = cmd->post_wait_value };
+	ret = (int)stub_ioctl(render, NVKVM_SYNC_FILE_FENCE_WAIT, &params);
+done:
+	if (source >= 0)
+		stub_close(source); /* native WAIT owns its reference after registration */
+	if (ret < 0)
+		send_error(ret);
+	else
+		send_ok();
+}
