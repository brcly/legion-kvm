+int nvkvm_isolate_import_sync_file(struct nvkvm_isolate_table *t,
+    uint32_t isolate_id, uint32_t render_handle, uint32_t context,
+    int sync_fd, uint64_t pre, uint64_t post)
+{
+	if (!isolate_id || isolate_id >= NVKVM_ISOLATE_MAX)
+		return -ENOENT;
+	if (pre >= post || sync_fd < -1)
+		return -EINVAL;
+	struct nvkvm_isolate *iso = &t->isolates[isolate_id];
+	pthread_mutex_lock(&iso->lock);
+	bool valid = iso->in_use && iso->id == isolate_id && iso->alive;
+	pthread_mutex_unlock(&iso->lock);
+	if (!valid)
+		return -ENOENT;
+	struct isolate_cmd_import_sync_file cmd = {
+		.type = ISOLATE_CMD_IMPORT_SYNC_FILE,
+		.render_handle = render_handle,
+		.fence_context_handle = context,
+		.flags = sync_fd < 0 ? NVKVM_SYNC_IMPORT_SIGNALED : 0,
+		.pre_wait_value = pre, .post_wait_value = post,
+	};
+	if (sync_fd < 0)
+		return sync_send_recv(iso, &cmd, sizeof(cmd));
+	struct iovec iov = { .iov_base = &cmd, .iov_len = sizeof(cmd) };
+	char control[CMSG_SPACE(sizeof(int))] = {0};
+	struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1,
+		.msg_control = control, .msg_controllen = sizeof(control) };
+	struct cmsghdr *cm = CMSG_FIRSTHDR(&msg);
+	cm->cmsg_level = SOL_SOCKET;
+	cm->cmsg_type = SCM_RIGHTS;
+	cm->cmsg_len = CMSG_LEN(sizeof(int));
+	memcpy(CMSG_DATA(cm), &sync_fd, sizeof(sync_fd));
+	return sync_sendmsg_recv(iso, &msg);
+}
