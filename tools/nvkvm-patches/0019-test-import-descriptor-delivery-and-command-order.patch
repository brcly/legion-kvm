 /* ── Test 7: poll / unpoll ───────────────────────────────────────────────── */
+
+TEST(sync_file_import_descriptor_and_order)
+{
+	fixture_init();
+	uint32_t iso = 0;
+	EXPECT_EQ(nvkvm_isolate_create(&g_it, 22, NULL, &iso), 0);
+	EXPECT_EQ(nvkvm_isolate_import_sync_file(&g_it, 0, 1, 2, -1, 0, 1), -ENOENT);
+	EXPECT_EQ(nvkvm_isolate_import_sync_file(&g_it, iso, 1, 2, -2, 0, 1), -EINVAL);
+	EXPECT_EQ(nvkvm_isolate_import_sync_file(&g_it, iso, 1, 2, -1, 3, 3), -EINVAL);
+	EXPECT_EQ(nvkvm_isolate_import_sync_file(&g_it, iso, 1, 2, -1, 3, 4), 0);
+	int fd = memfd_create("sync-import-test", MFD_CLOEXEC);
+	EXPECT_GE(fd, 0);
+	uint64_t marker = 0x12345678abcdef01ULL;
+	EXPECT_EQ(write(fd, &marker, sizeof(marker)), sizeof(marker));
+	EXPECT_EQ(lseek(fd, 0, SEEK_SET), 0);
+	EXPECT_EQ(nvkvm_isolate_import_sync_file(&g_it, iso, 1, 2, fd, 4, 5), 0);
+	/* The child actually read the SCM-passed file description. */
+	EXPECT_EQ(lseek(fd, 0, SEEK_CUR), sizeof(marker));
+	/* Next import sees EOF: error must not consume the following ACK. */
+	EXPECT_EQ(nvkvm_isolate_import_sync_file(&g_it, iso, 1, 2, fd, 5, 6), -EINVAL);
+	EXPECT_EQ(nvkvm_isolate_unpoll(&g_it, iso, 1), 0);
+	close(fd);
+	EXPECT_EQ(nvkvm_isolate_kill(&g_it, iso), 0);
+	EXPECT_EQ(nvkvm_isolate_import_sync_file(&g_it, iso, 1, 2, -1, 0, 1), -ENOENT);
+	fixture_fini();
+}
 
