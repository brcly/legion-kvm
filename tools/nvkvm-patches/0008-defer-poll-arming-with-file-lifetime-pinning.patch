 /* ── poll ─────────────────────────────────────────────────────────────────── */
 
+static void nvkvm_poll_arm_work(struct work_struct *work)
+{
+	struct nvkvm_fd_ctx *ctx = container_of(work, struct nvkvm_fd_ctx, poll_work);
+	struct file *file = ctx->poll_file;
+
+	if (nvkvm_virtio_poll_arm(ctx->session->isolate_id, ctx->handle_id, 1))
+		atomic_set(&ctx->poll_armed, 0);
+	/* Do not turn a failed arm into a busy wake/retry loop. The original
+	 * poll timeout remains the fallback. The retained file pins ctx/session
+	 * through this request; fput from a kworker defers the final release. */
+	fput(file);
+}
