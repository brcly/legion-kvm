+/* Only a private, negotiated viewer contract calls this: its update reply
+ * means a real GPU read fence completed, not merely that a frame was queued. */
+static void nvkvm_present_read_complete(void *opaque, bool success)
+{
+    NvkvmPresent *p = opaque;
+    if (!p->nv->display_read_ack)
+        return;
+    if (!success) {
+        strict_releases.errors++;
+        error_report("nvkvm: external viewer read failed; source remains owned");
+        return;
+    }
+    unsigned before = p->release_count;
+    nvkvm_release_queue(p, p->cur_context, p->cur_key, -1, true);
+    if (p->release_count > before) {
+        strict_releases.dropped--;
+        strict_releases.gpu++;
+    }
+}
+
+static void nvkvm_present_gl_block(void *opaque, bool blocked)
+{
+    NvkvmPresent *p = opaque;
+    if (p->nv->display_read_ack && !blocked)
+        qemu_bh_schedule(p->bh);
+}
