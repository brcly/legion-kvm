+	/* This virtual head has one host-paced timer for every resolution.
+	 * DMT's fixed 60/75 Hz clocks must not advertise a different cadence to
+	 * Wayland/Wine when the timer is actually running at (say) 240 Hz.
+	 * Scaling the dot clock preserves each mode's timing flags and totals.
+	 */
+	list_for_each_entry(mode, &conn->probed_modes, head) {
+		unsigned int old_hz = drm_mode_vrefresh(mode);
+
+		if (old_hz && old_hz != hz)
+			mode->clock = DIV_ROUND_CLOSEST_ULL((u64)mode->clock * hz,
+						       old_hz);
+	}
