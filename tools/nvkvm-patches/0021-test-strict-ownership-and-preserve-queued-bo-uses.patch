+static bool nvkvm_bp_drop_queued(struct nvkvm_kms *kms, u32 old_actor, u32 old_gem,
+    u32 new_actor, u32 new_gem)
+{
+	if (old_actor == new_actor && old_gem == new_gem)
+		return false;
+	struct nvkvm_bp_buffer *slot = nvkvm_bp_find(kms, old_actor, old_gem);
+	if (!slot)
+		return false;
+	slot->queued = false;
+	if (slot->held)
+		return false;
+	nvkvm_bp_untrack(kms, old_actor, old_gem);
+	return true;
+}
