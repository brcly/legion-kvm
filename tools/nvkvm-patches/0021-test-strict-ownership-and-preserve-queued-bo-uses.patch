--- /dev/null
+++ b/tests/unit/test_scanout_ownership.c
@@ -0,0 +1,68 @@
+/* Exercise production ownership helpers, extracted from nvkvm_kms.c. */
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+typedef uint32_t u32;
+#include "kms_ownership_types.inc"
+struct nvkvm_kms {
+    struct nvkvm_bp_buffer bp_inflight[NVKVM_KMS_BP_SLOTS];
+    unsigned int bp_next;
+};
+static struct { bool strict_scanout_release; } nvkvm;
+#include "kms_ownership.inc"
+
+int main(void)
+{
+    struct nvkvm_kms kms = {0};
+    nvkvm.strict_scanout_release = true;
+    struct nvkvm_bp_buffer *first = nvkvm_bp_track(&kms, 10, 1);
+    assert(first);
+    first->queued = first->held = true;
+    /* A host release cannot remove a separately queued use of that BO. */
+    nvkvm_bp_untrack(&kms, 10, 1);
+    assert(nvkvm_bp_find(&kms, 10, 1) == first && first->queued && !first->held);
+    /* Updating the framebuffer description for the same BO is not a drop. */
+    assert(!nvkvm_bp_drop_queued(&kms, 10, 1, 10, 1));
+    assert(first->queued);
+    /* A queued frame that was never consumed can safely be coalesced away. */
+    assert(nvkvm_bp_drop_queued(&kms, 10, 1, 10, 2));
+    assert(!nvkvm_bp_find(&kms, 10, 1));
+
+    first = nvkvm_bp_track(&kms, 10, 1);
+    first->queued = first->held = true;
+    assert(!nvkvm_bp_drop_queued(&kms, 10, 1, 10, 2));
+    assert(first->held && !first->queued);
+    nvkvm_bp_untrack(&kms, 10, 1);
+    assert(!nvkvm_bp_find(&kms, 10, 1));
+
+    /* GEM IDs are file-local, including within one isolate. */
+    first = nvkvm_bp_track(&kms, 20, 1);
+    struct nvkvm_bp_buffer *second = nvkvm_bp_track(&kms, 21, 1);
+    assert(first && second && first != second);
+    first->held = second->held = true;
+    nvkvm_bp_untrack(&kms, 20, 1);
+    assert(nvkvm_bp_find(&kms, 21, 1) == second && second->held);
+    nvkvm_bp_untrack(&kms, 20, 1); /* duplicate old release */
+    assert(second->held);
+
+    memset(&kms, 0, sizeof(kms));
+    for (unsigned int i = 0; i < NVKVM_KMS_BP_SLOTS; i++) {
+        struct nvkvm_bp_buffer *slot = nvkvm_bp_track(&kms, 30, i + 1);
+        assert(slot);
+        slot->held = true;
+    }
+    /* Allocation pressure must never forget a live reader. */
+    assert(!nvkvm_bp_track(&kms, 30, NVKVM_KMS_BP_SLOTS + 1));
+    for (unsigned int i = 0; i < NVKVM_KMS_BP_SLOTS; i++)
+        assert(nvkvm_bp_find(&kms, 30, i + 1)->held);
+    nvkvm_bp_untrack(&kms, 30, 1);
+    assert(nvkvm_bp_track(&kms, 30, NVKVM_KMS_BP_SLOTS + 1));
+
+    /* Preserve the legacy bounded-hint eviction policy outside strict mode. */
+    nvkvm.strict_scanout_release = false;
+    assert(nvkvm_bp_track(&kms, 40, 100));
+    puts("scanout ownership passed");
+    return 0;
+}
