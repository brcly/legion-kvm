+/* Strict SDL mode: the source is reusable only after its last host GPU
+ * read completes. The queue also retains completed notifications while VQ_EVT
+ * is full. A device-owned timer retries; no delayed BH can outlive teardown. */
+typedef struct NvkvmGpuRelease {
+    uint32_t context, key;
+    int fd;
+    bool ready, failed;
+} NvkvmGpuRelease;
+
+static void nvkvm_release_poll(void *opaque)
+{
+    NvkvmPresent *p = opaque;
+    for (GList *node = p->releases, *next; node; node = next) {
+        next = node->next;
+        NvkvmGpuRelease *r = node->data;
+        if (!r->ready && !r->failed) {
+            struct sync_file_info info = {0};
+            int ret = ioctl(r->fd, SYNC_IOC_FILE_INFO, &info);
+            if (!ret && info.status == 1) {
+                close(r->fd);
+                r->fd = -1;
+                r->ready = true;
+                p->release_gpu++;
+            } else if (ret < 0 || info.status < 0) {
+                r->failed = true;
+                p->release_errors++;
+                error_report("nvkvm: host read fence failed; source buffer remains owned");
+            }
+        }
+        if (r->ready && nvkvm_virtio_try_scanout_release(p->nv, r->context, r->key)) {
+            p->releases = g_list_delete_link(p->releases, node);
+            p->release_count--;
+            g_free(r);
+        }
+    }
+    if (p->releases)
+        timer_mod(p->release_timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 1);
+}
+
+static void nvkvm_release_queue(NvkvmPresent *p, uint32_t context, uint32_t key, int fd, bool ready)
+{
+    if (!p->nv->strict_scanout_release || !context || !key) {
+        if (fd >= 0) close(fd);
+        return;
+    }
+    if (p->release_count >= 128) {
+        if (fd >= 0) close(fd);
+        p->release_errors++;
+        error_report("nvkvm: host release queue full; source buffers remain owned");
+        return;
+    }
+    NvkvmGpuRelease *r = g_new0(NvkvmGpuRelease, 1);
+    r->context = context;
+    r->key = key;
+    r->fd = fd;
+    r->ready = ready;
+    p->releases = g_list_prepend(p->releases, r);
+    p->release_count++;
+    if (ready) p->release_dropped++;
+    timer_mod(p->release_timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 1);
+}
+
+static void nvkvm_release_after_gpu(NvkvmPresent *p, uint32_t context, uint32_t key)
+{
+    EGLDisplay display = eglGetCurrentDisplay();
+    if (display == EGL_NO_DISPLAY || !epoxy_has_egl_extension(display, "EGL_ANDROID_native_fence_sync")) {
+        p->release_errors++;
+        error_report("nvkvm: current display cannot export a GPU read fence; buffer remains owned");
+        return;
+    }
+    const EGLint attrs[] = { EGL_NONE };
+    EGLSyncKHR sync = eglCreateSyncKHR(display, EGL_SYNC_NATIVE_FENCE_ANDROID, attrs);
+    if (sync == EGL_NO_SYNC_KHR) {
+        p->release_errors++;
+        error_report("nvkvm: host GPU read fence creation failed; buffer remains owned");
+        return;
+    }
+    glFlush();
+    int fd = eglDupNativeFenceFDANDROID(display, sync);
+    eglDestroySyncKHR(display, sync);
+    if (fd < 0) {
+        p->release_errors++;
+        error_report("nvkvm: host GPU read fence export failed; buffer remains owned");
+        return;
+    }
+    nvkvm_release_queue(p, context, key, fd, false);
