+/* Strict releases are proofs, not pacing hints. Caller retains and retries
+ * when VQ_EVT has no free descriptor; no allocated BH can outlive the device. */
+bool nvkvm_virtio_try_scanout_release(VirtIONvgpu *nv, uint32_t render_handle, uint32_t gem)
+{
+	assert(bql_locked());
+	if (!nv || !nv->strict_scanout_release || !nv->vq_evt)
+		return false;
+	VirtQueueElement *elem = virtqueue_pop(nv->vq_evt, sizeof(*elem));
+	if (!elem)
+		return false;
+	struct nvkvm_evt_release msg = {
+		.isolate_id = cpu_to_le32(render_handle),
+		.stub_handle = cpu_to_le32(gem),
+		.type = cpu_to_le32(NVKVM_EVT_TYPE_SCANOUT_RELEASE),
+	};
+	virtqueue_push(nv->vq_evt, elem, iov_from_buf(elem->in_sg, elem->in_num, 0, &msg, sizeof(msg)));
+	virtio_notify(VIRTIO_DEVICE(nv), nv->vq_evt);
+	g_free(elem);
+	return true;
 }
 
