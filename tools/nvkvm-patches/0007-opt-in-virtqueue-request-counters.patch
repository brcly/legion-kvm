+/* Opt-in diagnostic counters. VQ dispatch is serialized by the BQL. */
+static uint64_t nvkvm_request_counts[64];
+static bool nvkvm_request_stats_enabled;
+static bool nvkvm_request_stats_initialized;
+
+static void nvkvm_request_stats_dump(void)
+{
+    for (unsigned i = 0; i < ARRAY_SIZE(nvkvm_request_counts); i++) {
+        if (nvkvm_request_counts[i]) {
+            fprintf(stderr, "nvkvm request total: type=%u count=%" PRIu64 "\n",
+                    i, nvkvm_request_counts[i]);
+        }
+    }
+}
+
+static void nvkvm_request_stats_record(uint32_t type)
+{
+    if (!nvkvm_request_stats_initialized) {
+        const char *value = getenv("NVKVM_REQUEST_STATS");
+        nvkvm_request_stats_enabled = value && !strcmp(value, "1");
+        if (nvkvm_request_stats_enabled) {
+            atexit(nvkvm_request_stats_dump);
+        }
+        nvkvm_request_stats_initialized = true;
+    }
+    if (nvkvm_request_stats_enabled && type < ARRAY_SIZE(nvkvm_request_counts)) {
+        nvkvm_request_counts[type]++;
+    }
+}
