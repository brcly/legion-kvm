+/* OGKM 620.70.06: sizeof(params)=229392, operations[4096] @8,
+ * sizeof(operation)=56. No host pointers: only owned RM handles, GPU offsets
+ * and inline semaphore values. Refuse malformed counts/types before RM. */
+static inline int nvkvm_ctrl_params_valid(uint32_t cmd, const void *aux, uint32_t size)
+{
+    if (cmd != 0x00fe0101u) return 1;
+    if (!aux || size != 229392u) return 0;
+    const uint8_t *p = aux;
+    uint32_t count = (uint32_t)p[0] | (uint32_t)p[1] << 8 |
+                     (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+    if (count > 4096u) return 0;
+    for (uint32_t i = 0; i < count; i++) {
+        const uint8_t *op = p + 8u + i * 56u;
+        uint32_t type = (uint32_t)op[0] | (uint32_t)op[1] << 8 |
+                        (uint32_t)op[2] << 16 | (uint32_t)op[3] << 24;
+        if (type > 4u) return 0;
+    }
+    return 1;
+}
