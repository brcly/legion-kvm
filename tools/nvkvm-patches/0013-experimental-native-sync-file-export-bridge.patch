+TEST(test_sync_file_handles_reject_unrelated_descriptors)
+{
+	struct nvkvm_handle_table t;
+	nvkvm_handle_table_init(&t);
+	uint32_t pending = 0, memory = 0, session = 0;
+	ASSERT_EQ(nvkvm_handle_alloc_sync_file(&t, 7, &pending), 0);
+	struct nvkvm_handle *h = nvkvm_handle_get(&t, pending);
+	ASSERT_NOTNULL(h);
+	ASSERT_EQ(h->type, NVKVM_HANDLE_TYPE_SYNC_FILE);
+	ASSERT_EQ(h->fd, -1);
+	ASSERT_EQ(open_test_memory_handle(&t, 7, &memory), 0);
+	struct nvkvm_handle *mem = nvkvm_handle_get(&t, memory);
+	ASSERT_NOTNULL(mem);
+	ASSERT_EQ(nvkvm_handle_attach_sync_file(&t, pending, mem->fd), -EBADF);
+	ASSERT_EQ(nvkvm_handle_acquire_sync_file(&t, memory, &session), -EBADF);
+	ASSERT_EQ(nvkvm_handle_acquire_sync_file(&t, pending, &session), -EBADF);
+	int pipefd[2];
+	ASSERT_EQ(pipe(pipefd), 0);
+	ASSERT_EQ(nvkvm_handle_attach_sync_file(&t, pending, pipefd[0]), -EBADF);
+	close(pipefd[0]);
+	close(pipefd[1]);
+	nvkvm_handle_abort_open(&t, pending);
+	ASSERT_NULL(nvkvm_handle_get(&t, pending));
+	nvkvm_handle_table_fini(&t);
+}
