+/* Sync-file handles can only originate in a graphics fence export. */
+int nvkvm_handle_alloc_sync_file(struct nvkvm_handle_table *t,
+                                uint32_t session_id, uint32_t *handle_id_out)
+{
+	pthread_mutex_lock(&t->lock);
+	uint32_t id;
+	struct nvkvm_handle *h = alloc_slot(t, &id);
+	if (!h) {
+		pthread_mutex_unlock(&t->lock);
+		return -EMFILE;
+	}
+	h->type = NVKVM_HANDLE_TYPE_SYNC_FILE;
+	h->fd = -1;
+	h->session_id = session_id;
+	h->dev_id = NVKVM_DEV_SYNC_FILE;
+	*handle_id_out = id;
+	pthread_mutex_unlock(&t->lock);
+	return 0;
+}
+
+int nvkvm_handle_attach_sync_file(struct nvkvm_handle_table *t,
+                                uint32_t handle_id, int fd)
+{
+	if (!handle_id || handle_id >= NVKVM_HANDLE_MAX || fd < 0)
+		return -EINVAL;
+	pthread_mutex_lock(&t->lock);
+	struct nvkvm_handle *h = &t->handles[handle_id];
+	bool valid = h->in_use && h->id == handle_id && h->fd < 0 &&
+		     h->type == NVKVM_HANDLE_TYPE_SYNC_FILE;
+	uint64_t generation = h->generation;
+	pthread_mutex_unlock(&t->lock);
+	if (!valid)
+		return -EBADF;
+	/* A device, eventfd, memfd, or DRM syncobj descriptor is not a sync_file.
+	 * Query metadata only (num_fences=0), without accepting arbitrary ioctls. */
+	struct sync_file_info info = {0};
+	int ret;
+	do {
+		ret = ioctl(fd, SYNC_IOC_FILE_INFO, &info);
+	} while (ret < 0 && errno == EINTR);
+	if (ret < 0)
+		return -EBADF;
+	pthread_mutex_lock(&t->lock);
+	valid = h->in_use && h->id == handle_id && h->generation == generation &&
+		h->type == NVKVM_HANDLE_TYPE_SYNC_FILE && h->fd < 0;
+	if (valid)
+		h->fd = fd;
+	pthread_mutex_unlock(&t->lock);
+	return valid ? 0 : -EBADF;
+}
+
+int nvkvm_handle_acquire_sync_file(struct nvkvm_handle_table *t,
+                                  uint32_t handle_id, uint32_t *session_id)
+{
+	if (!handle_id || handle_id >= NVKVM_HANDLE_MAX)
+		return -EBADF;
+	pthread_mutex_lock(&t->lock);
+	struct nvkvm_handle *h = &t->handles[handle_id];
+	int fd = -EBADF;
+	if (h->in_use && h->id == handle_id && h->fd >= 0 &&
+	    h->type == NVKVM_HANDLE_TYPE_SYNC_FILE) {
+		fd = fcntl(h->fd, F_DUPFD_CLOEXEC, 0);
+		if (fd < 0)
+			fd = -errno;
+		else if (session_id)
+			*session_id = h->session_id;
+	}
+	pthread_mutex_unlock(&t->lock);
+	return fd;
 }
 
