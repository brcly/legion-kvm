+		nvkvm_handle_unref_isolate(&nv->handles, output);
+		nvkvm_handle_abort_open(&nv->handles, output);
+		resp->status = (uint32_t)-ret;
+		return 0;
+	}
+	resp->handle_id = output;
+	resp->status = 0;
+	return 0;
