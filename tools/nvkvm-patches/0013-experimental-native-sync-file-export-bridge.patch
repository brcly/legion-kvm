+++ b/src/guest/nvkvm_sync_file.c
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Actual host sync_files behind guest DMA fences. Experimental, feature gated. */
+#include <linux/dma-fence.h>
+#include <linux/file.h>
+#include <linux/jiffies.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/sync_file.h>
+#include <linux/workqueue.h>
+#include "nvkvm.h"
+
+static struct workqueue_struct *sync_wq;
+
+struct nvkvm_sync_fence {
+	struct dma_fence base;
+	spinlock_t lock;
+	struct nvkvm_fd_ctx *ctx;
+	struct work_struct poll_work;
+	struct work_struct cleanup;
+};
+
+static const char *sync_driver_name(struct dma_fence *fence)
+{
+	return "nvkvm";
+}
+
+static const char *sync_timeline_name(struct dma_fence *fence)
+{
+	return "host.sync_file";
+}
+
+static bool sync_enable_signaling(struct dma_fence *fence)
+{
+	/* Monitoring begins at creation, independent of the first consumer. */
+	return true;
+}
+
+static void sync_cleanup(struct work_struct *work)
+{
+	struct nvkvm_sync_fence *nf = container_of(work, struct nvkvm_sync_fence, cleanup);
+	/* A final put from poll_work can queue us before that worker returns. */
+	cancel_work_sync(&nf->poll_work);
+	nvkvm_fd_ctx_close(nf->ctx);
+	dma_fence_free(&nf->base);
+	/* Module exit drains sync_wq before code can be unmapped. */
+	module_put(THIS_MODULE);
+}
+
+static void sync_release(struct dma_fence *fence)
+{
+	struct nvkvm_sync_fence *nf = container_of(fence, struct nvkvm_sync_fence, base);
+	queue_work(sync_wq, &nf->cleanup);
+}
+
+static const struct dma_fence_ops sync_ops = {
+	.get_driver_name = sync_driver_name,
+	.get_timeline_name = sync_timeline_name,
+	.enable_signaling = sync_enable_signaling,
+	.release = sync_release,
+};
+
+static void sync_poll(struct work_struct *work)
+{
+	struct nvkvm_sync_fence *nf = container_of(work, struct nvkvm_sync_fence, poll_work);
+	struct nvkvm_fd_ctx *ctx = nf->ctx;
+	int status = 0;
+	bool armed = false;
+
+	for (;;) {
+		if (!nvkvm_transport_ready(&nvkvm)) {
+			/* Device removal aborts the virtual operation, never succeeds. */
+			status = -ENODEV;
+			break;
+		}
+		if (!armed) {
+			atomic_set(&ctx->poll_armed, 1);
+			armed = nvkvm_virtio_poll_arm(ctx->session->isolate_id,
+				ctx->handle_id, 1) == 0;
+			if (!armed)
+				atomic_set(&ctx->poll_armed, 0);
+		}
+		/* Only the native sync_file's terminal status proves completion.
+		 * An IRQ is a wakeup, not permission to reuse an unfinished buffer.
+		 * The timed query also tolerates a missed event or a full poll set. */
+		int ret = nvkvm_virtio_sync_file_status(ctx, &status);
+		if (!ret && (status == 1 || (status < 0 && status >= -MAX_ERRNO)))
+			break;
+		wait_event_timeout(ctx->poll_wq,
+			atomic_xchg(&ctx->poll_events, 0), msecs_to_jiffies(10));
+	}
+	if (status < 0)
+		dma_fence_set_error(&nf->base, status);
+	dma_fence_signal(&nf->base);
+	dma_fence_put(&nf->base); /* monitoring reference */
+}
+
+struct dma_fence *nvkvm_sync_fence_export(struct nvkvm_fd_ctx *owner,
+    __u32 fence_context, __u32 timeout_ms, __u64 wait_value)
+{
+	__u32 handle = 0;
+	int ret;
+	if (!nvkvm.sync_file_bridge)
+		return ERR_PTR(-EOPNOTSUPP);
+	ret = nvkvm_virtio_export_sync_file(owner, fence_context, timeout_ms, wait_value, &handle);
+	if (ret)
+		return ERR_PTR(ret);
+	if (!handle)
+		return ERR_PTR(-EPROTO);
+	struct nvkvm_fd_ctx *ctx = nvkvm_fd_ctx_adopt_sync_file(owner, handle);
+	if (IS_ERR(ctx)) {
+		nvkvm_virtio_close_handle_on_isolate(handle, owner->session->isolate_id);
+		nvkvm_virtio_close_handle(handle);
+		return ERR_CAST(ctx);
+	}
+	struct nvkvm_sync_fence *nf = kzalloc(sizeof(*nf), GFP_KERNEL);
+	if (!nf) {
+		nvkvm_fd_ctx_close(ctx);
+		return ERR_PTR(-ENOMEM);
+	}
+	if (!try_module_get(THIS_MODULE)) {
+		nvkvm_fd_ctx_close(ctx);
+		kfree(nf);
+		return ERR_PTR(-ENODEV);
+	}
+	nf->ctx = ctx;
+	spin_lock_init(&nf->lock);
+	INIT_WORK(&nf->poll_work, sync_poll);
+	INIT_WORK(&nf->cleanup, sync_cleanup);
+	/* Independent native fences must not share an ordered timeline context. */
+	dma_fence_init(&nf->base, &sync_ops, &nf->lock, dma_fence_context_alloc(1), 1);
+	dma_fence_get(&nf->base);
+	queue_work(sync_wq, &nf->poll_work);
+	return &nf->base;
+}
+
+int nvkvm_sync_file_export(struct nvkvm_fd_ctx *owner,
+    __u32 fence_context, __u32 timeout_ms, __u64 wait_value)
+{
