+int nvkvm_req_export_sync_file(VirtIONvgpu *nv,
+    struct nvkvm_req_export_sync_file *req,
+    struct nvkvm_resp_export_sync_file *resp)
+{
+	resp->handle_id = 0;
+	resp->status = EPERM;
+	if (!nv->graphics || !nv->sync_file_bridge ||
+	    !poll_pair_ok(nv, req->handle_id, req->isolate_id))
+		return 0;
+	struct nvkvm_handle *render = nvkvm_handle_get(&nv->handles, req->handle_id);
+	if (!render || render->type != NVKVM_HANDLE_TYPE_NVIDIA ||
+	    render->dev_id < 32 || render->dev_id >= 48)
+		return 0;
+	uint32_t output = 0;
+	int fd = -1;
+	int ret = nvkvm_handle_alloc_sync_file(&nv->handles, render->session_id, &output);
+	if (ret < 0) {
+		resp->status = (uint32_t)-ret;
+		return 0;
+	}
+	/* Reserve the isolate reference before export. It is released on every
+	 * failure, or by the guest's ordinary close-on-isolate/close sequence. */
+	nvkvm_handle_ref_isolate(&nv->handles, output);
+	ret = nvkvm_isolate_export_sync_file(&nv->isolates, req->isolate_id,
+		req->handle_id, output, req->fence_context_handle,
+		req->timeout_ms, req->wait_value, &fd);
+	bool exported = ret == 0;
+	if (!ret)
+		ret = nvkvm_handle_attach_sync_file(&nv->handles, output, fd);
+	if (ret < 0) {
+		if (fd >= 0)
+			close(fd);
+		if (exported)
