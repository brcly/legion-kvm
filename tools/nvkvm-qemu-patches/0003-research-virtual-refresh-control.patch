+            /* Research-only override for measuring virtual pacing separately
+             * from the physical monitor. Invalid values preserve host timing. */
+            const char *override = getenv("LEGION_VIRTUAL_REFRESH_HZ");
+            unsigned int hz;
+            if (override && qemu_strtoui(override, NULL, 10, &hz) == 0 &&
+                hz >= 1 && hz <= 1000) {
+                info.refresh_rate = hz * 1000;
+            }
             qemu_console_set_ui_info(scon->dcl.con, &info, true);
